# Firebase web config — Console > Project settings > Your apps > Web app.
#
# These are NOT secrets. They ship in the public bundle by design and identify
# the project, they don't authorise anything. Security comes from the Firestore
# rules and App Check. They live in env vars for hygiene, not protection.
#
# Local: copy to `.env`. CI: set as GitHub Actions repository secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. reCAPTCHA v3 site key for App Check. Leave blank in dev; set before
# going public, since the global category collection is otherwise reachable by curl.
VITE_RECAPTCHA_SITE_KEY=
